{
  "name": "AdventureWorks Profesional",
  "dataColors": [
    "#1F6E8C",
    "#149B8D",
    "#E3A647",
    "#576E94",
    "#9AB7C7",
    "#C86B65"
  ],
  "background": "#FFFFFF",
  "foreground": "#17324D",
  "tableAccent": "#1F6E8C",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#17324D"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5B6B7D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ],
        "border": [
          {
